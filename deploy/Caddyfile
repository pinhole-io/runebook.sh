# Public install host. curl receives the script. A browser receives the frontpage.
runebook.sh {
	# A file on this host wins. A missing macOS file redirects to the release.
	@macos path_regexp macos ^/dl/(runebook-macos-[A-Za-z0-9._-]+)$
	handle @macos {
		root * /srv/runebook
		route {
			@missing not file
			redir @missing https://github.com/pinhole-io/runebook.sh/releases/download/binaries/{re.macos.1} 302
			header Cache-Control "no-cache"
			file_server
		}
	}

	handle /dl/* {
		root * /srv/runebook
		header Cache-Control "no-cache"
		file_server
	}

	@uninstall {
		header User-Agent *curl*
		path /uninstall
	}
	@curl header User-Agent *curl*

	handle @uninstall {
		root * /srv/runebook
		rewrite * /uninstall.sh
		header {
			Content-Type "text/x-shellscript; charset=utf-8"
			Cache-Control "no-store"
		}
		file_server
	}

	handle @curl {
		root * /srv/runebook
		rewrite * /install.sh
		header {
			Content-Type "text/x-shellscript; charset=utf-8"
			Cache-Control "no-store"
		}
		file_server
	}

	handle {
		reverse_proxy https://pages.runebook.sh {
			header_up Host pages.runebook.sh
			@github header Location *github.io*
			handle_response @github {
				header Location "https://runebook.sh{http.request.uri}"
				copy_response
			}
		}
	}
}
