# Public install host. curl receives the script. A browser receives the frontpage.
runebook.sh {
	handle /dl/* {
		root * /srv/runebook
		header Cache-Control "no-cache"
		file_server
	}

	@uninstall {
		header User-Agent *curl*
		path /uninstall
	}
	@curl header User-Agent *curl*

	handle @uninstall {
		root * /srv/runebook
		rewrite * /uninstall.sh
		header {
			Content-Type "text/x-shellscript; charset=utf-8"
			Cache-Control "no-store"
		}
		file_server
	}

	handle @curl {
		root * /srv/runebook
		rewrite * /install.sh
		header {
			Content-Type "text/x-shellscript; charset=utf-8"
			Cache-Control "no-store"
		}
		file_server
	}

	handle {
		reverse_proxy https://pages.runebook.sh {
			header_up Host pages.runebook.sh
			@github header Location *github.io*
			handle_response @github {
				header Location "https://runebook.sh{http.request.uri}"
				copy_response
			}
		}
	}
}
