{
  "name": "Blue Topaz Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#202020",
    "editor.foreground": "#c6c6c6",
    "editor.lineHighlightBackground": "#222222",
    "editorLineNumber.foreground": "#797979",
    "editorLineNumber.activeForeground": "#c6c6c6",
    "editorWhitespace.foreground": "#79797966",
    "editorGutter.background": "#202020",
    "editorCursor.foreground": "#c6c6c6",
    "editor.selectionBackground": "#3b767160",
    "editorError.foreground": "#e16d76",
    "editorWarning.foreground": "#cac685",
    "editorInfo.foreground": "#478fee",
    "editorHint.foreground": "#a0c7e9",
    "sideBar.background": "#151515",
    "sideBar.foreground": "#c6c6c6",
    "sideBar.border": "#343434",
    "list.activeSelectionBackground": "#373737",
    "list.activeSelectionForeground": "#c6c6c6",
    "list.hoverBackground": "#2b2b2b",
    "list.inactiveSelectionBackground": "#ffffff1a",
    "titleBar.activeBackground": "#151515",
    "titleBar.border": "#343434",
    "statusBar.background": "#151515",
    "statusBar.border": "#343434",
    "tab.activeBackground": "#202020",
    "tab.inactiveBackground": "#151515",
    "tab.activeForeground": "#c6c6c6",
    "tab.inactiveForeground": "#8a8a8a",
    "editorGroupHeader.tabsBackground": "#151515",
    "button.background": "#2d82cc",
    "button.foreground": "#e4e4e4",
    "button.hoverBackground": "#3488d2",
    "button.secondaryBackground": "#2b2b2b",
    "button.secondaryForeground": "#c6c6c6",
    "button.secondaryHoverBackground": "#373737",
    "focusBorder": "#2d82cc",
    "panel.border": "#343434",
    "input.border": "#343434",
    "dropdown.background": "#222222",
    "dropdown.foreground": "#c6c6c6",
    "textLink.foreground": "#2d82cc",
    "textLink.activeForeground": "#3488d2",
    "descriptionForeground": "#8a8a8a",
    "errorForeground": "#e16d76",
    "scrollbarSlider.background": "#3f3f3f7e",
    "scrollbarSlider.hoverBackground": "#4d4d4d88"
  },
  "tokenColors": [
    { "scope": "comment.line", "settings": { "foreground": "#568060" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#568060" } },
    { "scope": "keyword.control", "settings": { "foreground": "#478fee" } },
    { "scope": "string.quoted", "settings": { "foreground": "#abd58e" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#abd58e" } },
    { "scope": "string.regexp", "settings": { "foreground": "#a0c7e9" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#abd58e" } },
    { "scope": "constant.language", "settings": { "foreground": "#cac685" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#cac685" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#a0c7e9" } },
    { "scope": "variable", "settings": { "foreground": "#db7c84" } },
    { "scope": "variable.language", "settings": { "foreground": "#c594d4" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#a0c7e9" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#db7c84" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#cac685" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#a89984" } },
    { "scope": "punctuation", "settings": { "foreground": "#abb2bf" } },
    { "scope": "markup.heading", "settings": { "foreground": "#96c22e", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#ebdbb2" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#2d82cc" } }
  ]
}
