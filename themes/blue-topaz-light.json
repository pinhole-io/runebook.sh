{
  "name": "Blue Topaz Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#0e0e0e",
    "editor.lineHighlightBackground": "#e9e9e9",
    "editorLineNumber.foreground": "#7f7f7f",
    "editorLineNumber.activeForeground": "#0e0e0e",
    "editorWhitespace.foreground": "#7f7f7f66",
    "editorGutter.background": "#ffffff",
    "editorCursor.foreground": "#0e0e0e",
    "editor.selectionBackground": "#a9d1c859",
    "editorError.foreground": "#e75545",
    "editorWarning.foreground": "#ab9a02",
    "editorInfo.foreground": "#3b84e4",
    "editorHint.foreground": "#5e81ac",
    "sideBar.background": "#fcfcfc",
    "sideBar.foreground": "#0e0e0e",
    "sideBar.border": "#dddddd",
    "list.activeSelectionBackground": "#e6e6e6",
    "list.activeSelectionForeground": "#0e0e0e",
    "list.hoverBackground": "#efefef",
    "list.inactiveSelectionBackground": "#00000014",
    "titleBar.activeBackground": "#fcfcfc",
    "titleBar.border": "#dddddd",
    "statusBar.background": "#fcfcfc",
    "statusBar.border": "#dddddd",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#fcfcfc",
    "tab.activeForeground": "#0e0e0e",
    "tab.inactiveForeground": "#7f7f7f",
    "editorGroupHeader.tabsBackground": "#fcfcfc",
    "button.background": "#468eeb",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1d85db",
    "button.secondaryBackground": "#efefef",
    "button.secondaryForeground": "#0e0e0e",
    "button.secondaryHoverBackground": "#e6e6e6",
    "focusBorder": "#468eeb",
    "panel.border": "#dddddd",
    "input.border": "#dddddd",
    "dropdown.background": "#f3f3f3",
    "dropdown.foreground": "#0e0e0e",
    "textLink.foreground": "#468eeb",
    "textLink.activeForeground": "#1d85db",
    "descriptionForeground": "#7f7f7f",
    "errorForeground": "#e75545",
    "scrollbarSlider.background": "#dcdcdcbe",
    "scrollbarSlider.hoverBackground": "#ddddddd9"
  },
  "tokenColors": [
    { "scope": "comment.line", "settings": { "foreground": "#068a5e" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#068a5e" } },
    { "scope": "keyword.control", "settings": { "foreground": "#3bd4da" } },
    { "scope": "string.quoted", "settings": { "foreground": "#A3BE8C" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#A3BE8C" } },
    { "scope": "string.regexp", "settings": { "foreground": "#5e81ac" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#ab9a02" } },
    { "scope": "constant.language", "settings": { "foreground": "#BF616A" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#BF616A" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#5e81ac" } },
    { "scope": "variable", "settings": { "foreground": "#0e0e0e" } },
    { "scope": "variable.language", "settings": { "foreground": "#c74df7" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#5e81ac" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#c74df7" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#ab9a02" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#383a42" } },
    { "scope": "punctuation", "settings": { "foreground": "#7f7f7f" } },
    { "scope": "markup.heading", "settings": { "foreground": "#08377d", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#000000" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#468eeb" } }
  ]
}
