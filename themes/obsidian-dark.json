{
  "name": "Obsidian Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#202020",
    "editor.foreground": "#dcddde",
    "editor.lineHighlightBackground": "#1a1a1a",
    "editorLineNumber.foreground": "#666666",
    "editorLineNumber.activeForeground": "#dcddde",
    "editorWhitespace.foreground": "#66666666",
    "editorGutter.background": "#202020",
    "editorCursor.foreground": "#dcddde",
    "editor.selectionBackground": "#17304dfc",
    "editorError.foreground": "#fb464c",
    "editorWarning.foreground": "#e9973f",
    "editorInfo.foreground": "#027aff",
    "editorHint.foreground": "#a882ff",
    "sideBar.background": "#161616",
    "sideBar.foreground": "#dcddde",
    "sideBar.border": "#333333",
    "list.activeSelectionBackground": "#303030",
    "list.activeSelectionForeground": "#dcddde",
    "list.hoverBackground": "#2a2a2a",
    "list.inactiveSelectionBackground": "#ffffff1a",
    "titleBar.activeBackground": "#161616",
    "titleBar.border": "#333333",
    "statusBar.background": "#161616",
    "statusBar.border": "#333333",
    "tab.activeBackground": "#202020",
    "tab.inactiveBackground": "#161616",
    "tab.activeForeground": "#dcddde",
    "tab.inactiveForeground": "#999999",
    "editorGroupHeader.tabsBackground": "#161616",
    "button.background": "#483699",
    "button.foreground": "#dcddde",
    "button.hoverBackground": "#4d3ca6",
    "button.secondaryBackground": "#2a2a2a",
    "button.secondaryForeground": "#dcddde",
    "button.secondaryHoverBackground": "#303030",
    "focusBorder": "#7f6df2",
    "panel.border": "#333333",
    "input.border": "#333333",
    "dropdown.background": "#1a1a1a",
    "dropdown.foreground": "#dcddde",
    "textLink.foreground": "#7f6df2",
    "textLink.activeForeground": "#8875ff",
    "descriptionForeground": "#999999",
    "errorForeground": "#ff3333",
    "inputValidation.errorBackground": "#3d0000",
    "scrollbarSlider.background": "#ffffff1a",
    "scrollbarSlider.hoverBackground": "#ffffff33"
  },
  "tokenColors": [
    { "scope": "comment.line", "settings": { "foreground": "#666666" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#666666" } },
    { "scope": "keyword.control", "settings": { "foreground": "#fa99cd" } },
    { "scope": "string.quoted", "settings": { "foreground": "#44cf6e" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#44cf6e" } },
    { "scope": "string.regexp", "settings": { "foreground": "#53dfdd" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#a882ff" } },
    { "scope": "constant.language", "settings": { "foreground": "#e9973f" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#e0de71" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#e0de71" } },
    { "scope": "variable", "settings": { "foreground": "#dcddde" } },
    { "scope": "variable.language", "settings": { "foreground": "#a882ff" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#53dfdd" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#fb464c" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#e9973f" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#fb464c" } },
    { "scope": "punctuation", "settings": { "foreground": "#999999" } },
    { "scope": "markup.heading", "settings": { "foreground": "#dcddde", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#999999" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#7f6df2" } }
  ]
}
