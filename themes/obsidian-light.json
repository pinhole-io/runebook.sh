{
  "name": "Obsidian Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#2e3338",
    "editor.lineHighlightBackground": "#f5f6f8",
    "editorLineNumber.foreground": "#999999",
    "editorLineNumber.activeForeground": "#2e3338",
    "editorWhitespace.foreground": "#99999966",
    "editorGutter.background": "#ffffff",
    "editorCursor.foreground": "#2e3338",
    "editor.selectionBackground": "#cce6fffc",
    "editorError.foreground": "#e93147",
    "editorWarning.foreground": "#ec7500",
    "editorInfo.foreground": "#086ddd",
    "editorHint.foreground": "#7852ee",
    "sideBar.background": "#f2f3f5",
    "sideBar.foreground": "#2e3338",
    "sideBar.border": "#dddddd",
    "list.activeSelectionBackground": "#e3e5e8",
    "list.activeSelectionForeground": "#2e3338",
    "list.hoverBackground": "#e9e9e9",
    "list.inactiveSelectionBackground": "#00000014",
    "titleBar.activeBackground": "#f2f3f5",
    "titleBar.border": "#dddddd",
    "statusBar.background": "#f2f3f5",
    "statusBar.border": "#dddddd",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f2f3f5",
    "tab.activeForeground": "#2e3338",
    "tab.inactiveForeground": "#888888",
    "editorGroupHeader.tabsBackground": "#f2f3f5",
    "button.background": "#7b6cd9",
    "button.foreground": "#f2f2f2",
    "button.hoverBackground": "#8273e6",
    "button.secondaryBackground": "#f2f3f5",
    "button.secondaryForeground": "#2e3338",
    "button.secondaryHoverBackground": "#e9e9e9",
    "focusBorder": "#705dcf",
    "panel.border": "#dddddd",
    "input.border": "#dddddd",
    "dropdown.background": "#f5f6f8",
    "dropdown.foreground": "#2e3338",
    "textLink.foreground": "#705dcf",
    "textLink.activeForeground": "#7a6ae6",
    "descriptionForeground": "#888888",
    "errorForeground": "#800000",
    "inputValidation.errorBackground": "#990000",
    "scrollbarSlider.background": "#0000001a",
    "scrollbarSlider.hoverBackground": "#00000033"
  },
  "tokenColors": [
    { "scope": "comment.line", "settings": { "foreground": "#999999" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#999999" } },
    { "scope": "keyword.control", "settings": { "foreground": "#d53984" } },
    { "scope": "string.quoted", "settings": { "foreground": "#08b94e" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#08b94e" } },
    { "scope": "string.regexp", "settings": { "foreground": "#00bfbc" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#7852ee" } },
    { "scope": "constant.language", "settings": { "foreground": "#ec7500" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#e0ac00" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#e0ac00" } },
    { "scope": "variable", "settings": { "foreground": "#2e3338" } },
    { "scope": "variable.language", "settings": { "foreground": "#7852ee" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#00bfbc" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#e93147" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#ec7500" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#e93147" } },
    { "scope": "punctuation", "settings": { "foreground": "#888888" } },
    { "scope": "markup.heading", "settings": { "foreground": "#2e3338", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#888888" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#705dcf" } }
  ]
}
