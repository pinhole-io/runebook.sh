{
  "name": "Runebook Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0a0a0a",
    "editor.foreground": "#CACCCA",
    "editor.lineHighlightBackground": "#171717",
    "editorLineNumber.foreground": "#8F8F8F",
    "editorLineNumber.activeForeground": "#DDDDDD",
    "editorWhitespace.foreground": "#73737366",
    "editorCursor.foreground": "#fafafa",
    "editor.selectionBackground": "#1d4ed8",
    "editorHint.foreground": "#b283f8",
    "sideBar.background": "#0a0a0a",
    "sideBar.foreground": "#f5f5f5",
    "sideBar.border": "#262626",
    "list.activeSelectionBackground": "#262626",
    "list.activeSelectionForeground": "#f5f5f5",
    "list.inactiveSelectionBackground": "#17171766",
    "titleBar.activeBackground": "#171717",
    "titleBar.border": "#262626",
    "statusBar.background": "#171717",
    "statusBar.border": "#262626",
    "tab.activeBackground": "#0a0a0a",
    "tab.inactiveBackground": "#00000000",
    "tab.activeForeground": "#fafafa",
    "tab.inactiveForeground": "#d4d4d4",
    "editorGroupHeader.tabsBackground": "#171717",
    "button.background": "neutral-50",
    "button.foreground": "neutral-900",
    "button.hoverBackground": "neutral-100",
    "button.secondaryBackground": "neutral-800",
    "button.secondaryForeground": "neutral-50",
    "button.secondaryHoverBackground": "#292929",
    "focusBorder": "neutral-500",
    "panel.border": "neutral-800",
    "input.border": "#2f2f2f",
    "dropdown.background": "neutral-950",
    "dropdown.foreground": "neutral-50",
    "textLink.foreground": "#fafafa",
    "textLink.activeForeground": "#d4d4d4",
    "descriptionForeground": "neutral-400",
    "errorForeground": "red-600",
    "inputValidation.errorBackground": "red-400",
    "scrollbarSlider.background": "#525252e6",
    "scrollbarSlider.hoverBackground": "#525252"
  },
  "tokenColors": [
    { "scope": "comment.line", "settings": { "foreground": "#9D9D9D" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#9D9D9D" } },
    { "scope": "keyword.control", "settings": { "foreground": "#87B1F6" } },
    { "scope": "string.quoted", "settings": { "foreground": "#A3E09F" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#68DC7C" } },
    { "scope": "string.regexp", "settings": { "foreground": "#68DC7C" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#CC9E00" } },
    { "scope": "constant.language", "settings": { "foreground": "#CC9E00" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#B3C5F3" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#CBA6F7" } },
    { "scope": "variable.language", "settings": { "foreground": "#419CFF" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#BCC4E0" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#419CFF" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#7FAEF9" } },
    { "scope": "markup.heading", "settings": { "foreground": "#CC9E00" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#A3E09F" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#419CFF" } }
  ],
  "runebook": {
    "font.family": "Noto Sans",
    "font.size": 14,
    "mono_font.family": "Noto Sans Mono",
    "mono_font.size": 13,
    "radius": 6,
    "radius.lg": 8,
    "spacing": {
      "paragraph_gap": 1.0,
      "heading_before": 1.0,
      "heading.1": 1.4,
      "heading.2": 1.2
    }
  }
}
