{
  "name": "Runebook Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#000000",
    "editor.lineHighlightBackground": "#F5F5F5",
    "editorLineNumber.foreground": "#929292",
    "editorLineNumber.activeForeground": "#000000",
    "editorWhitespace.foreground": "#73737366",
    "editorCursor.foreground": "#0a0a0a",
    "editor.selectionBackground": "#55a0fc",
    "editorWarning.foreground": "#C99401",
    "editorHint.foreground": "#9e5dff",
    "sideBar.background": "#fafafa",
    "sideBar.foreground": "#171717",
    "sideBar.border": "#e5e5e5",
    "list.activeSelectionBackground": "#e5e5e5",
    "list.activeSelectionForeground": "#171717",
    "list.hoverBackground": "#f5f5f5",
    "list.inactiveSelectionBackground": "#fafafa",
    "titleBar.activeBackground": "#F8F8F8",
    "titleBar.border": "#e5e5e5",
    "statusBar.background": "#F8F8F8",
    "statusBar.border": "#e5e5e5",
    "tab.activeBackground": "white",
    "tab.inactiveBackground": "#00000000",
    "tab.activeForeground": "#171717",
    "tab.inactiveForeground": "#404040",
    "editorGroupHeader.tabsBackground": "#f5f5f5",
    "button.background": "neutral-900",
    "button.foreground": "neutral-50",
    "button.hoverBackground": "neutral-800",
    "button.secondaryBackground": "neutral-200",
    "button.secondaryForeground": "neutral-900",
    "button.secondaryHoverBackground": "neutral-200",
    "focusBorder": "neutral-400",
    "panel.border": "neutral-200",
    "input.border": "neutral-200",
    "dropdown.background": "white",
    "dropdown.foreground": "neutral-950",
    "textLink.foreground": "#0a0a0a",
    "textLink.activeForeground": "#0a0a0a",
    "descriptionForeground": "neutral-500",
    "errorForeground": "neutral-50",
    "inputValidation.errorBackground": "red-500",
    "scrollbarSlider.background": "#a3a3a3e6",
    "scrollbarSlider.hoverBackground": "#a3a3a3"
  },
  "tokenColors": [
    { "scope": "comment.line", "settings": { "foreground": "#007fff" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#007fff" } },
    { "scope": "keyword.control", "settings": { "foreground": "#0433ff" } },
    { "scope": "string.quoted", "settings": { "foreground": "#036A07" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#036A07" } },
    { "scope": "string.regexp", "settings": { "foreground": "#036A07" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#0433ff" } },
    { "scope": "constant.language", "settings": { "foreground": "#C5060B" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#0000A2" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#6f42c1" } },
    { "scope": "variable", "settings": { "foreground": "#333333" } },
    { "scope": "variable.language", "settings": { "foreground": "#C5060B" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#333333" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#0433ff" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#957931" } },
    { "scope": "markup.heading", "settings": { "foreground": "#0433FF" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#6F42C1" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#0000A2" } }
  ],
  "runebook": {
    "font.family": "Noto Sans",
    "font.size": 14,
    "mono_font.family": "Noto Sans Mono",
    "mono_font.size": 13,
    "radius": 6,
    "radius.lg": 8,
    "spacing": {
      "paragraph_gap": 1.0,
      "heading_before": 1.0,
      "heading.1": 1.4,
      "heading.2": 1.2
    }
  }
}
